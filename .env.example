# ── Application ──────────────────────────────────────────────
APP_NAME=vision-inference-microservice
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Model ────────────────────────────────────────────────────
MODEL_NAME=yolov8n.pt
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_DEVICE=cpu
# Where bare weight filenames are downloaded to and cached.
# Defaults to ~/.cache/vision-inference/weights; the container overrides it.
# MODEL_WEIGHTS_DIR=/home/appuser/.cache/vision-inference/weights

# ── CORS ─────────────────────────────────────────────────
# JSON list. Narrow this in production; credentials are ignored while the
# origin list is a wildcard, because browsers reject that combination.
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
