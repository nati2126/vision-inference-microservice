# Application
APP_NAME=vision-inference-microservice
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Model
# pytorch | onnxruntime | openvino | tensorrt
MODEL_BACKEND=pytorch
# yolov8n.pt, models/yolov8n.onnx, models/yolov8n_int8.onnx,
# models/yolov8n_openvino/yolov8n.xml, models/yolov8n_fp16.engine
MODEL_PATH=yolov8n.pt
# cpu | cuda | mps
MODEL_DEVICE=cpu
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IOU_THRESHOLD=0.7
MODEL_MAX_DETECTIONS=300
# MODEL_WEIGHTS_DIR=/home/appuser/.cache/vision-inference/weights

# CORS
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
