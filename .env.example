# Application
APP_NAME=vision-inference-microservice
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Model
# pytorch | onnxruntime | openvino | tensorrt
MODEL_BACKEND=pytorch
# yolov8n.pt, models/yolov8n.onnx, models/yolov8n_int8.onnx,
# models/yolov8n_openvino/yolov8n.xml, models/yolov8n_fp16.engine
MODEL_PATH=yolov8n.pt
# cpu | cuda | mps
MODEL_DEVICE=cpu
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IOU_THRESHOLD=0.7
MODEL_MAX_DETECTIONS=300
# MODEL_WEIGHTS_DIR=/home/appuser/.cache/vision-inference/weights

# Upload limits
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=50000000

# Batching: requests already queued behind a model call share the next one.
# 1 turns batching off; the model's own limit caps it (ONNX Runtime CUDA: 1).
BATCH_MAX_SIZE=8
# How long a model call waits for more requests; 0 never delays a lone request.
BATCH_TIMEOUT_MS=0

# CORS
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
