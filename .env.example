# ── Application ──────────────────────────────────────────────
APP_NAME=vision-inference-microservice
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Model ────────────────────────────────────────────────────
# Runtime: pytorch | onnxruntime | openvino | tensorrt
MODEL_BACKEND=pytorch
# Artifact for that backend (produce the exported ones with
# `python -m scripts.export_models`):
#   pytorch      yolov8n.pt (downloaded on first start)
#   onnxruntime  models/yolov8n.onnx  or  models/yolov8n_int8.onnx
#   openvino     models/yolov8n_openvino/yolov8n.xml  or  models/yolov8n_int8_openvino/yolov8n_int8.xml
#   tensorrt     models/yolov8n_fp16.engine
# MODEL_NAME is still accepted as an alias.
MODEL_PATH=yolov8n.pt
# cpu | cuda (pytorch, onnxruntime) | mps (pytorch). tensorrt needs cuda.
MODEL_DEVICE=cpu
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IOU_THRESHOLD=0.7
MODEL_MAX_DETECTIONS=300
# Where bare weight filenames are downloaded to and cached.
# Defaults to ~/.cache/vision-inference/weights; the container overrides it.
# MODEL_WEIGHTS_DIR=/home/appuser/.cache/vision-inference/weights

# ── CORS ─────────────────────────────────────────────────
# JSON list. Narrow this in production; credentials are ignored while the
# origin list is a wildcard, because browsers reject that combination.
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
